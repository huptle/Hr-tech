generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model HrUser {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         String     @default("HR Manager")
  designation  String     @default("HR Manager")
  company      String     @default("")
  phone        String     @default("")
  isAdmin      Boolean    @default(false)
  googleAccessToken  String @default("")
  googleRefreshToken String @default("")
  googleTokenExpiry  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  activities   Activity[]
  templates    Template[]
  schedulingCampaigns SchedulingCallCampaign[]
  createdJobs         Job[]                  @relation("JobCreator")
  brokerProfile       BrokerProfile?
}

model BrokerProfile {
  id             String            @id @default(cuid())
  brokerCode     String            @unique // e.g., "BRK-7841"
  userId         String            @unique
  user           HrUser            @relation(fields: [userId], references: [id], onDelete: Cascade)
  agencyName     String            @default("")
  status         String            @default("pending") // "pending", "approved", "rejected"
  commissionRate Float             @default(10) // default 10%
  payoutDetails  String            @default("") // UPI, bank info, pan
  phone          String            @default("")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  candidates     BrokerCandidate[]
  applications   Candidate[]       @relation("BrokerCandidateApplications")
  commissions    Commission[]
  jobsPosted     Job[]             @relation("BrokerPostedJobs")
}

model BrokerCandidate {
  id              String            @id @default(cuid())
  brokerId        String
  broker          BrokerProfile     @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  name            String
  email           String
  phone           String?
  location        String            @default("")
  skills          String            @default("")
  experienceYears Float             @default(0)
  expectedSalary  String            @default("")
  currentCompany  String            @default("")
  resumeUrl       String            @default("")
  parsedDataJson  String            @default("")
  notes           String            @default("")
  consentGiven    Boolean           @default(true)
  consentDate     DateTime          @default(now())
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  applications    Candidate[]       @relation("BrokerCandidateSource")
}

model Job {
  id                   String              @id @default(cuid())
  title                String
  description          String              @default("")
  screeningDurationMin Int                 @default(15)
  status               String              @default("Live")
  dept                 String              @default("")
  location             String              @default("")
  mode                 String              @default("Remote")
  createdById          String?
  createdBy            HrUser?             @relation("JobCreator", fields: [createdById], references: [id], onDelete: SetNull)
  brokerPosterId       String?
  brokerPoster         BrokerProfile?      @relation("BrokerPostedJobs", fields: [brokerPosterId], references: [id], onDelete: SetNull)
  isBrokerEligible     Boolean             @default(true)
  commissionType       String              @default("fixed") // "fixed" | "percentage"
  commissionAmount     Float               @default(20000)
  approvalStatus       String              @default("approved") // "approved" | "pending_approval" | "rejected"
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  candidates           Candidate[]
  questions            ScreeningQuestion[]
  slots                InterviewSlot[]
  activities           Activity[]
  schedulingCampaigns  SchedulingCallCampaign[]
  commissions          Commission[]
}

model ScreeningQuestion {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  order Int
  text  String
}

model Candidate {
  id                    String          @id @default(cuid())
  jobId                 String
  job                   Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  brokerId              String?
  broker                BrokerProfile?  @relation("BrokerCandidateApplications", fields: [brokerId], references: [id], onDelete: SetNull)
  brokerCandidateId     String?
  brokerCandidate       BrokerCandidate? @relation("BrokerCandidateSource", fields: [brokerCandidateId], references: [id], onDelete: SetNull)
  source                String          @default("direct") // "direct" | "broker" | "partner"
  consentVerified       Boolean         @default(false)
  name                  String
  email                 String
  phone                 String?
  location              String          @default("")
  resumeNotes           String          @default("")
  joiningAvailability   String          @default("")
  resumeVerified        Boolean         @default(false)
  status                String          @default("imported")
  journey               String          @default("Applied")
  rankScore             Float?
  voiceTranscriptNotes  String          @default("")
  /** Short manager-facing summary (Gemini). */
  aiSummary             String          @default("")
  /** JSON array: { "question": string, "answer": string }[] for async text screening. */
  asyncScreeningAnswers String          @default("")
  /** Public URL of uploaded resume (e.g. Supabase Storage). */
  resumeUrl             String          @default("")
  /** Supabase profiles.id or other external portal id. */
  externalProfileId     String          @default("")
  /** Full parsed resume JSON from candidate apply portal. */
  parsedDataJson        String          @default("")
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@unique([jobId, email])
  bookedSlots           InterviewSlot[]
  activities            Activity[]
  schedulingCalls       SchedulingCall[]
  commissions           Commission[]
}

model Commission {
  id             String        @id @default(cuid())
  brokerId       String
  broker         BrokerProfile @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  candidateId    String
  candidate      Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  amount         Float
  rate           Float         @default(0)
  type           String        @default("fixed") // "fixed" | "percentage"
  status         String        @default("Pending") // "Pending", "Approved", "Paid", "Reversed"
  joiningDate    DateTime?
  verifiedAt     DateTime?
  verifiedById   String?
  paidAt         DateTime?
  transactionRef String        @default("")
  notes          String        @default("")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model InterviewSlot {
  id          String     @id @default(cuid())
  jobId       String
  job         Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  startsAt    DateTime
  endsAt      DateTime
  mode        String     @default("hr")
  candidateId String?
  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
}

model Template {
  id        String   @id @default(cuid())
  title     String
  type      String   @default("Email")
  category  String   @default("Other")
  body      String   @default("")
  authorId  String?
  author    HrUser?  @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Activity {
  id          String     @id @default(cuid())
  tag         String
  what        String
  actorId     String?
  actor       HrUser?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  candidateId String?
  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  jobId       String?
  job         Job?       @relation(fields: [jobId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
}

/** HR-initiated batch of Vapi calls to collect interview availability (India +91). */
model SchedulingCallCampaign {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  actorId   String
  actor     HrUser   @relation(fields: [actorId], references: [id], onDelete: Cascade)
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  calls     SchedulingCall[]
}

model SchedulingCall {
  id              String   @id @default(cuid())
  campaignId      String
  campaign        SchedulingCallCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  candidateId     String
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  phoneE164       String
  vapiCallId      String   @default("")
  status          String   @default("queued")
  transcript      String   @default("")
  parsedAvailability String @default("")
  bookedSlotId    String?
  errorMessage    String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
